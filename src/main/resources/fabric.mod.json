{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Template mod description",
  "authors": [
    "Redheris"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/ Template",
    "sources": "https://github.com/Redheris/RhMods-Template"
  },
  "license": "MIT",
  "icon": "assets/templatemod/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.redheris.templatemod.TemplateModClient"
    ],
    "main": [
      "dev.redheris.templatemod.TemplateMod"
    ]
  },
  "mixins": [
    "template.mixins.json"
  ],
  "accessWidener": "${id}.classtweaker",
  "depends": {
    "fabricloader": ">=${fabric_loader}",
    "fabric-api": "*",
    "minecraft": "${minecraft}"
  }
}
